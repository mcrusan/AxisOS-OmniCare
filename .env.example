# ==============================================================================
# File: .env.example
# Project: AxisOS OmniCare (AWS CDS & Bedrock AgentCore Cloud-to-Edge Control)
# Author: Marc F. Crusan / Crusan & Co. w/ AGY
# Date: 2026-10-20
# Description: Environment configuration template for AWS Communication Developer
#              Services (CDS), Amazon Bedrock AgentCore, and AxisOS Triad nodes.
# Changelog:
#   - 2026-10-20 (MFC/AGY): Added AxisOS Sovereign Triad & Outpost Cloud-01 URLs.
# ==============================================================================

# AWS Credentials & Region
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=us-west-2

# AWS Communication Developer Services (CDS / End User Messaging & SES)
CDS_SMS_ORIGINATION_NUMBER=+18005550199
CDS_WHATSAPP_PHONE_NUMBER_ID=waba-phone-id-001
CDS_SES_FROM_EMAIL=omnicare@axisos.pro
DYNAMODB_STATE_TABLE=omnicare-conversation-state

# Amazon Bedrock AgentCore Configuration
AGENTCORE_CONFIG_PATH=src/omnicare/agent/agentcore.yaml
AGENTCORE_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
AGENTCORE_AGENT_ID=AXISOS-OMNICARE-CORE

# AxisOS Sovereign Triad Edge Endpoints (Bare-Metal Pi & Cloud Run Outpost)
AXISOS_ZERO_CORE_URL=http://192.168.1.34:8081
AXISOS_LITE_URL=http://192.168.1.34:8080
AXISOS_AGENT_URL=http://192.168.1.34:8082
AXISOS_COMMS_URL=http://192.168.1.34:8085
AXISOS_CLOUD_OUTPOST_URL=https://axisos-sovereign-triad-4zye7tn3qq-uw.a.run.app

# Application Runtime
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
